# --- Shelly Cloud (Shelly app → User settings → Authorization cloud key) ---
SHELLY_SERVER=shelly-XX-eu.shelly.cloud
SHELLY_DEVICE_ID=your-device-id
SHELLY_AUTH_KEY=
# v2 (default, recommended by Shelly) or v1 (deprecated /device/status)
SHELLY_API_VERSION=v2

# --- Prices: all-in CZK per kWh incl. distribution and VAT ---
PRICE_VT_CZK=
PRICE_NT_CZK=

# --- EG.D HDO (low-tariff times) ---
# Receiver povel as on the HDO box, e.g. A1B4DP6, or the code name from egd.cz, e.g. 405 / PH8_13
EGD_HDO_CODE=
# Optional: VYCHOD, ZAPAD, VERSACOM, PH, SM, TOU (needed if the code exists in more regions)
EGD_HDO_REGION=
# Optional: your distribution tariff, e.g. D25d (picks the right relay/times)
EGD_HDO_TARIFF=D25d
# Used when EG.D data can't be loaded. "00:00-06:00,13:00-15:00" or "1-5=22:00-06:00;6-7=00:00-08:00"
HDO_FALLBACK=00:00-06:00,13:00-15:00

# --- Thresholds in CZK ---
LIMIT_HOUR_CZK=20
LIMIT_DAY_CZK=200

# --- Upstash QStash: calls /api/collect every 3 minutes (see README) ---
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Optional: only if the schedule's destination isn't https://<Vercel production domain>/api/collect
QSTASH_COLLECT_URL=

# --- Access ---
# Long random strings, e.g. `openssl rand -hex 24`. COLLECT_SECRET is for manual calls (?key=…)
DASHBOARD_TOKEN=
COLLECT_SECRET=

# --- Storage: added automatically by the Vercel Marketplace Upstash integration ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

